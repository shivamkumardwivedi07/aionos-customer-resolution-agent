# Environment Configuration for Airline Customer Resolution Agent
# Can be run in deterministic offline mode without any external API keys.
PORT=8000
HOST=0.0.0.0
AGENT_MODE=hybrid # 'hybrid', 'llm', or 'deterministic'
# Optional LLM API Key (if provided, enables LLM natural language refinement)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
